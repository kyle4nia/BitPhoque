contract KCC20(byte[32] genesisPk, int genesisAmount, byte genesisIdentifierType, bool genesisIsMinter, bool genesisForSale, int genesisPrice, int maxCovIns, int maxCovOuts) {
    byte constant IDENTIFIER_PUBKEY = 0x00;
    byte[32] ownerIdentifier = genesisPk;
    byte identifierType = genesisIdentifierType;
    int amount = genesisAmount;
    bool isMinter = genesisIsMinter;
    bool forSale = genesisForSale;
    int price = genesisPrice;

    // Per-input authorization: either the owner signs (normal transfer / listing),
    // OR the input is for-sale and the tx pays >= price to the owner (sale claim).
    function checkAuth(State[] prevStates, sig[] sigs, byte[] witnesses) {
        for(i, 0, prevStates.length, maxCovIns) {
            if(!prevStates[i].forSale){
                require(checkSig(sigs[i], prevStates[i].ownerIdentifier));
            } else {
                byte[34] sellerLock = new ScriptPubKeyP2PK(prevStates[i].ownerIdentifier);
                require(tx.outputs[witnesses[i]].scriptPubKey == byte[](sellerLock));
                require(tx.outputs[witnesses[i]].value >= prevStates[i].price);
            }
        }
    }

    function checkAmounts(State[] prevStates, State[] newStates) {
        if(!isMinter){
            int totalIn = 0;
            for(i, 0, prevStates.length, maxCovIns) {
                totalIn = totalIn + prevStates[i].amount;
            }
            int totalOut = 0;
            for(i, 0, newStates.length, maxCovOuts) {
                totalOut = totalOut + newStates[i].amount;
            }
            require(totalIn == totalOut);
        }
    }

    function checkMintingTransfer(State[] newStates){
        if(!isMinter){
            for(i, 0, newStates.length, maxCovOuts) {
                require(!newStates[i].isMinter);
            }
        }
    }

    // Sale-state rule (the listing/claim separation):
    //  - LISTING (owner-signed, all inputs NOT for-sale): for-sale outputs ALLOWED.
    //  - CLAIM (any input IS for-sale, payment-authorized): no output may be for-sale
    //    (anti-double-claim: a claimed UTXO must not stay on the market).
    function checkSaleState(State[] prevStates, State[] newStates){
        bool anyInputForSale = false;
        for(i, 0, prevStates.length, maxCovIns) {
            if(prevStates[i].forSale){
                anyInputForSale = true;
            }
        }
        if(anyInputForSale){
            for(j, 0, newStates.length, maxCovOuts) {
                require(!newStates[j].forSale);
            }
        }
    }

    #[covenant(binding = cov, from = maxCovIns, to = maxCovOuts)]
    function transfer(State[] prevStates, State[] newStates, sig[] sigs, byte[] witnesses) {
        checkAuth(prevStates, sigs, witnesses);
        checkAmounts(prevStates, newStates);
        checkMintingTransfer(newStates);
        checkSaleState(prevStates, newStates);
    }
}
